# ── 登录与数据库 / Supabase ──
# 在 Supabase Auth 中配置 GitHub 与 Google OAuth；GitHub 按页面顺序优先。
# 用稳定生产域名，例如 https://studio.example.com；本地可填 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# 可公开的浏览器 anon key，用于 Supabase Auth；不是 service_role key。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，用于读写 AIGC 任务与作品记录。不要把它暴露给浏览器。
SUPABASE_SERVICE_ROLE_KEY=

# ── 对象存储 / Cloudflare R2(个人作品库取产物)──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── 图片生成服务选择 ──
# 只由部署者选择；普通使用者不会看到服务名称。
# 可选: modal（默认）/ modal-bridge / openrouter / fal / comfyui。
# 这是部署侧排序，不会自动 fallback；切换时只修改这一项并重新部署。
# modal-bridge = 通过 comfyui_modal_bridge 的 aigc-r2 交付(结果直传 R2 + 回调),见下方 Modal Bridge 段。
AIGC_IMAGE_PROVIDER=modal

# ── 图片生成 / Modal（AIGC_IMAGE_PROVIDER=modal 时需要）──
# 形如 https://your-modal-user--art-ai，实际调用会拼成 -run/-status/-cancel.modal.run
MODAL_ENDPOINT_BASE=
MODAL_KEY=
MODAL_SECRET=

# ── 图片生成 / Modal Bridge aigc-r2 交付（comfyui_modal_bridge，后续 AIGC_IMAGE_PROVIDER=modal-bridge 时需要）──
# 已部署的 comfyui_modal_bridge endpoint 根地址与 Bridge API Key（调用 /run 的 auth_key）。
MODAL_BRIDGE_ENDPOINT_BASE=
MODAL_BRIDGE_API_KEY=
# 内部交付 token（asset-intake / job-complete）的 HMAC 签名密钥。随机生成，只在服务端。
BRIDGE_DELIVERY_TOKEN_SECRET=
# 可选：仅当生产域名启用 Vercel Deployment Protection 时，给内部 endpoint 放行用。
# 同一个值也要放进 Modal Secret（AIGC_STUDIO_BYPASS_SECRET），让 Bridge 带 x-vercel-protection-bypass 头。
VERCEL_AUTOMATION_BYPASS_SECRET=

# ── 图片生成 / OpenRouter（AIGC_IMAGE_PROVIDER=openrouter 时需要）──
OPENROUTER_API_KEY=
# 默认图片模型；标准 / 细节增强没有单独填写时都会使用它。
OPENROUTER_IMAGE_MODEL=
# 可选：分别给“标准出图”与“细节增强”指定模型。
OPENROUTER_IMAGE_STANDARD_MODEL=
OPENROUTER_IMAGE_DETAIL_MODEL=
# 可选：例如 1K / 2K，1:1 / 16:9，low / medium / high，png / jpeg / webp。
OPENROUTER_IMAGE_RESOLUTION=
OPENROUTER_IMAGE_ASPECT_RATIO=
OPENROUTER_IMAGE_QUALITY=
OPENROUTER_IMAGE_OUTPUT_FORMAT=
# 可选：auto / transparent / opaque。
OPENROUTER_IMAGE_BACKGROUND=
# 可选：供 OpenRouter 控制台识别调用来源；填写网站地址和网站名称即可。
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AIGC Studio

# ── 图片生成 / 自建 ComfyUI API（AIGC_IMAGE_PROVIDER=comfyui 时需要）──
# 填自建 ComfyUI 服务根地址，不要在结尾加 /api。例如：https://comfy.example.com。
# 服务端还需要预先安装当前图片工作流所用的节点和模型。
COMFYUI_BASE_URL=
# 工作流用了 ComfyUI 付费 API 节点（例如 GPT Image）时填写。
# 这是部署者 ComfyUI 账号里有 API 积分的密钥：付费节点会从该账号扣费。
# 网站只在服务端把它放入 /prompt 的 extra_data.api_key_comfy_org，不会下发给浏览器。
COMFY_ORG_API_KEY=

# ── 视频 / 3D 后端选择 ──
# 默认 fal;设为 modal-bridge 则走 comfyui_modal_bridge(需先在插件里部署对应的视频/3D 工作流,
# 并在 registry 注册模板,否则会明确报 workflow_not_configured)。不是自动 fallback。
AIGC_VIDEO_PROVIDER=fal
AIGC_MODEL3D_PROVIDER=fal

# ── fal.ai Queue API（3D / 视频默认后端；AIGC_IMAGE_PROVIDER=fal 时图片也使用它）──
FAL_KEY=
# fal 图片：至少填写 FAL_IMAGE_ENDPOINT；可选按“标准 / 细节增强”分别覆盖。
# 只填 endpoint 路径，例如 fal-ai/flux/schnell，不要填 https://queue.fal.run。
FAL_IMAGE_ENDPOINT=
FAL_IMAGE_STANDARD_ENDPOINT=
FAL_IMAGE_DETAIL_ENDPOINT=
# 可选：不填则使用当前内置的 3D / 视频 endpoint。
FAL_MODEL3D_STANDARD_ENDPOINT=
FAL_MODEL3D_GAME_ASSET_ENDPOINT=
FAL_MODEL3D_STANDARD_IMAGE_ENDPOINT=
FAL_MODEL3D_GAME_ASSET_IMAGE_ENDPOINT=
FAL_MODEL3D_GAME_ASSET_MULTIVIEW_ENDPOINT=
FAL_VIDEO_ENDPOINT=

# 可选：逗号分隔的 Modal / fal 输出文件域名白名单。
# 只有自定义输出文件域名不在默认可信列表时才填写，例如 cdn.example.com,assets.example.com。
AIGC_ASSET_HOST_ALLOWLIST=

# ── 后台任务 / Cron ──
# 后台每天一次检查生成任务的专用口令。部署时必须随机生成,且只给 Vercel/部署者。
CRON_SECRET=
