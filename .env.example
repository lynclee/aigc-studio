# ── 飞书登录 / Lark OAuth ──
# 飞书开放平台「网页应用」OAuth 凭据
LARK_APP_ID=
LARK_APP_SECRET=
# 回调地址,需与飞书开放平台「安全设置-重定向 URL」一致,如 https://your-domain/api/auth/lark/callback
LARK_REDIRECT_URI=

# 会话 cookie 签名密钥(HMAC-SHA256)。部署时设一个随机长串,如 `openssl rand -hex 32`
SESSION_SECRET=

# ── 数据库 + Auth / Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 对象存储 / Cloudflare R2(作品画廊取产物)──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── 算力桥接 / comfyui_modal_bridge ──
# 由 comfyui_modal_bridge 插件部署到用户自己的 Modal 后得到
BRIDGE_API_KEY=
MODAL_ENDPOINT_BASE=

# ── 其它 / Misc ──
CRON_SECRET=
